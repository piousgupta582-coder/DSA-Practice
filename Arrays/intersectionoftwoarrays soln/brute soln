class Solution {
public:
    vector<int> intersection(vector<int>& nums1, vector<int>& nums2) {
        unordered_map<int,int> kes;
        vector<int> res;
        int n = nums1.size();
        int v = nums2.size();
        for(int i = 0;i<n;i++){
            for(int j = 0;j<v;j++){
                if(nums1[i]==nums2[j]){
                        kes.insert(nums1);
                        break;
                }
            }
        }
        for(auto it = kes.begin() ;it!=kes.end();it++){
            res.push_back(it->first);
        }
        return res;
    }
};
